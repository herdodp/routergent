{
  "name": "routergent",
  "version": "0.1.0",
  "description": "Standalone router for Snapgent connectors: multi-webview, auto-failover, shared handoff history.",
  "main": "src/main/main.js",
  "license": "GPL-3.0-or-later",
  "author": "herdodp <https://github.com/herdodp>",
  "homepage": "https://herdodp.github.io/routergent/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herdodp/routergent.git"
  },
  "bugs": {
    "url": "https://github.com/herdodp/routergent/issues"
  },
  "keywords": ["electron", "ai-router", "failover", "mcp", "snapgent", "webview", "agent"],
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.snapgent.routergent",
    "productName": "RouterGent",
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      {
        "from": "resources/snapgent-extension",
        "to": "snapgent-extension",
        "filter": ["**/*", "!test-*.js", "!**/node_modules/**"]
      },
      { "from": "resources/vscode_mcp.exe", "to": "vscode_mcp.exe" },
      { "from": "resources/config.json", "to": "config.json" }
    ],
    "win": { "target": "portable", "signAndEditExecutable": false }
  }
}
